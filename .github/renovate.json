{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "schedule": ["before 2am"],
  "minimumReleaseAge": "3 days",
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboard": true,
  "labels": ["dependencies", "no-stale"],
  "platformAutomerge": true,
  "lockFileMaintenance": {
    "enabled": false
  },
  "commitMessagePrefix": "⬆️",
  "packageRules": [
    {
      "description": "UV project dependencies",
      "matchFileNames": ["pyproject.toml", "uv.lock"],
      "addLabels": ["python"]
    },
    {
      "description": "Pin UV development dependencies",
      "matchFileNames": ["pyproject.toml", "uv.lock"],
      "matchDepTypes": ["dependency-groups"],
      "rangeStrategy": "pin"
    },
    {
      "description": "Automerge minor/patch UV dependency updates (after approval and CI)",
      "matchFileNames": ["pyproject.toml", "uv.lock"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchManagers": ["npm", "nvm"],
      "addLabels": ["javascript"],
      "rangeStrategy": "pin"
    },
    {
      "matchManagers": ["npm", "nvm"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["github_actions"],
      "rangeStrategy": "pin"
    },
    {
      "description": "Automerge minor/patch GitHub Actions updates (after CI passes)",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Don't automerge major GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
